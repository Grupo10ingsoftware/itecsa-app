# Copiar a deploy/production.env (ignorado por Git).
API_IMAGE=ghcr.io/grupo10ingsoftware/itecsa-app-api@sha256:<digest-api>
WEB_IMAGE=ghcr.io/grupo10ingsoftware/itecsa-app-web@sha256:<digest-web>
# SHA informativo de la pareja; el proceso lee APP_VERSION grabado en su imagen.
APP_VERSION=<sha-completo-del-commit>
FRONTEND_ORIGIN=http://localhost:8080
API_ENV_FILE=./capaServidor/.env
WEB_ENV_FILE=./capaVista/.env
DB_CA_FILE=./capaServidor/certs/aiven-ca.pem
BIND_ADDRESS=127.0.0.1
TRUST_PROXY_HOPS=0
