# Servidor HTTP local.
NODE_ENV=development
# Entornos reales: resend; requiere API key y remitente verificado.
# Tests automatizados: fake, exclusivamente con NODE_ENV=test.
# Desarrollo temporal: console (imprime OTP); prohibido en production/test.
# Sin seleccion explicita, la recuperacion permanece deshabilitada.
PIN_DELIVERY_PROVIDER=resend
RESEND_API_KEY=
PIN_EMAIL_FROM=
ENABLE_DEMO_ROUTES=false
APP_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=0
JSON_BODY_LIMIT=100kb
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
ENABLE_INTERNAL_READINESS=false
INTERNAL_HEALTH_TOKEN=
TEMPORARY_DATA_CLEANUP_INTERVAL_MS=3600000

# Auth0 API: valores publicos/configurables del tenant y la API ITECSA.
AUTH0_DOMAIN=<tenant-auth0>
AUTH0_AUDIENCE=https://api.itecsa.local

# Auth0 Management: solo backend. No usar estos valores en capaVista.
AUTH0_MANAGEMENT_CLIENT_ID=<client-id-m2m>
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_DATABASE_CONNECTION=Username-Password-Authentication
AUTH0_PASSWORD_RESET_CLIENT_ID=<client-id-spa>
AUTH0_REQUEST_TIMEOUT_MS=8000

# PIN personal: secreto exclusivo del backend.
# Generar uno distinto por ambiente con: openssl rand -base64 32
PIN_SECRET=<generar-32-bytes-en-base64>
RATE_LIMIT_SECRET=<generar-32-bytes-en-base64>
CURSOR_SECRET=<generar-32-bytes-en-base64>
SECURITY_LOG_HMAC_KEY=<generar-32-bytes-en-base64>

# Base de datos MySQL/Aiven usada por Prisma con adaptador MariaDB.
DB_HOST=<host-aiven>
DB_PORT=<puerto-aiven>
DB_USER=<usuario-aiven>
DB_PASSWORD=
DB_NAME=<nombre-bd>
DB_SSL_CA_PATH=./certs/aiven-ca.pem
DB_SSL_MODE=required
DB_CONNECT_TIMEOUT_MS=8000
DB_QUERY_TIMEOUT_MS=15000

# P18: habilitar sólo tras validar aviso, responsables, calendario, migración y operación.
PRIVACY_ENABLED=false
PRIVACY_ENCRYPTION_KEY=<generar-32-bytes-hex-propios-en-gestor-de-secretos>
PRIVACY_STAFF_SUBJECTS=
PRIVACY_POLICY_PATH=

# Prisma CLI usa esta URL para introspeccion y generacion.
DATABASE_URL=mysql://<usuario-aiven>:<password-aiven>@<host-aiven>:<puerto-aiven>/<nombre-bd>?sslcert=./certs/aiven-ca.pem&sslaccept=strict
