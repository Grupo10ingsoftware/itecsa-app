generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Cliente {
  id_cliente     Int       @id @default(autoincrement())
  rut_cliente    String?   @unique(map: "rut_cliente_UNIQUE") @db.VarChar(12)
  nombre_cliente String?   @db.VarChar(100)
  razon_social   String?   @db.VarChar(150)
  estado_cliente String?   @db.VarChar(30)
  Pedidos        Pedidos[]
}

model Comentario_Produccion {
  id_comentario_produccion Int             @id
  comentario               String?         @db.Text
  fecha_comentario         DateTime?       @db.DateTime(0)
  id_usuario               Int?
  id_detalle_pedido        Int?
  Detalle_pedido           Detalle_pedido? @relation(fields: [id_detalle_pedido], references: [id_detalle_pedido], onDelete: NoAction, onUpdate: NoAction, map: "fk_cp_detalle_pedido")
  Usuario                  Usuario?        @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_cp_usuario")

  @@index([id_detalle_pedido], map: "id_detalle_pedido_idx")
  @@index([id_usuario], map: "id_usuario_idx")
}

model Detalle_pedido {
  id_detalle_pedido      Int                     @id @default(autoincrement())
  linea_origen          String?                 @db.VarChar(100)
  codigo_origen         String?                 @db.VarChar(50)
  producto_origen       String?                 @db.VarChar(255)
  familia_origen        String?                 @db.VarChar(100)
  subfamilia_origen      String?                 @db.VarChar(100)
  cantidad               Int?
  fecha_estimada_termino DateTime?               @db.DateTime(0)
  fecha_real_termino     DateTime?               @db.DateTime(0)
  id_pedido              Int?
  id_tipo_producto       Int?
  id_estado_subproceso   Int?
  Comentario_Produccion  Comentario_Produccion[]
  Estado_Subprocesos     Estado_Subprocesos?     @relation(fields: [id_estado_subproceso], references: [id_estado_subproceso], onDelete: NoAction, onUpdate: NoAction, map: "Detalle_pedido_Estado_Subprocesos_FK")
  Pedidos                Pedidos?                @relation(fields: [id_pedido], references: [id_pedido], onDelete: NoAction, onUpdate: NoAction, map: "id_pedido")
  Tipo_Producto          Tipo_Producto?          @relation(fields: [id_tipo_producto], references: [id_tipo_producto], onDelete: NoAction, onUpdate: NoAction, map: "id_tipo_producto")
  Avance_Lanyard         Avance_Lanyard[]
  Dise_o                 Dise_o[]
  registro_subprocesos   registro_subprocesos[]

  @@index([id_pedido], map: "id_pedido_idx")
  @@index([id_tipo_producto], map: "id_tipo_producto_idx")
  @@index([id_estado_subproceso], map: "Detalle_pedido_Estado_Subprocesos_FK")
}

model Dise_o {
  id_dise_o         Int             @id @map("id_diseño")
  especificaciones  String?         @db.Text
  id_detalle_pedido Int?
  Detalle_pedido    Detalle_pedido? @relation(fields: [id_detalle_pedido], references: [id_detalle_pedido], onDelete: NoAction, onUpdate: NoAction, map: "id_detalle_pedido")
  Dise_o_Lanyard    Dise_o_Lanyard?
  Dise_o_Tarjeta    Dise_o_Tarjeta?

  @@index([id_detalle_pedido], map: "id_detalle_pedido_idx")
  @@map("Diseño")
}

model Dise_o_Lanyard {
  id_dise_o     Int      @id @map("id_diseño")
  color         String?  @db.VarChar(50)
  leyenda       String?  @db.VarChar(255)
  largo_lanyard Decimal? @db.Decimal(10, 2)
  ancho_lanyard Decimal? @db.Decimal(10, 2)
  Dise_o        Dise_o   @relation(fields: [id_dise_o], references: [id_dise_o], onDelete: NoAction, onUpdate: NoAction, map: "id_diseño")

  @@map("Diseño_Lanyard")
}

model Dise_o_Tarjeta {
  id_dise_o    Int                          @id @map("id_diseño")
  tipo_tarjeta Dise_o_Tarjeta_tipo_tarjeta?
  Dise_o       Dise_o                       @relation(fields: [id_dise_o], references: [id_dise_o], onDelete: NoAction, onUpdate: NoAction, map: "fk_diseño_tarjeta_diseño")

  @@map("Diseño_Tarjeta")
}

model Estado_Pago {
  id_estado_pago                                                   Int             @id @default(autoincrement())
  nombre_estado_pago                                               String?         @db.VarChar(45)
  descripcion_estado_pago                                          String?         @db.VarChar(105)
  Pedidos                                                          Pedidos[]
  Registro_Pago_Registro_Pago_id_estado_pago_nuevoToEstado_Pago    Registro_Pago[] @relation("Registro_Pago_id_estado_pago_nuevoToEstado_Pago")
  Registro_Pago_Registro_Pago_id_estado_pago_anteriorToEstado_Pago Registro_Pago[] @relation("Registro_Pago_id_estado_pago_anteriorToEstado_Pago")
}

model Estado_Pedido {
  id_estado_pedido   Int               @id @default(autoincrement())
  nombre_etapa       String?           @db.VarChar(100)
  orden_kanban       Int?
  descripcion_estado String?           @db.VarChar(45)
  Pedidos            Pedidos[]
  Registro_Etapas    Registro_Etapas[]
}

model Estado_Subprocesos {
  id_estado_subproceso Int                    @id
  nombre_estado        String?                @db.VarChar(100)
  descripcion_estado   String?                @db.Text
  Detalle_pedido       Detalle_pedido[]
  Producto_Subproceso  Producto_Subproceso[]
  registro_subprocesos registro_subprocesos[]
}

model Pedidos {
  id_pedido                   Int                           @id @default(autoincrement())
  fecha_creacion              DateTime?                     @db.Date
  fecha_estimada_termino      DateTime?                     @db.Date
  id_usuario                  Int?
  id_estado_pedido            Int?
  id_estado_pago              Int?
  id_cliente                  Int?
  id_etiqueta                 Int?
  observacion                 String?                       @db.Text
  numero_nota_venta           String?                       @unique(map: "Pedidos_numero_nota_venta_UNIQUE") @db.VarChar(50)
  usuario_manager_origen      String?                       @db.VarChar(100)
  observacion_origen          String?                       @db.Text
  observacion_interna         String?                       @db.Text
  Detalle_pedido              Detalle_pedido[]
  Mensaje                     Mensaje[]
  Pedido_Etiqueta             Pedido_Etiqueta[]
  Pedido_Item_Sin_Seguimiento Pedido_Item_Sin_Seguimiento[]
  Cliente                     Cliente?                      @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction, map: "id_cliente")
  Estado_Pago                 Estado_Pago?                  @relation(fields: [id_estado_pago], references: [id_estado_pago], onDelete: NoAction, onUpdate: NoAction, map: "Pedidos_Estado_Pago_FK")
  Estado_Pedido               Estado_Pedido?                @relation(fields: [id_estado_pedido], references: [id_estado_pedido], onDelete: NoAction, onUpdate: NoAction, map: "Pedidos_Estado_Pedido_FK")
  etiqueta                    etiqueta?                     @relation(fields: [id_etiqueta], references: [id_etiqueta], onDelete: NoAction, onUpdate: NoAction, map: "id_etiqueta")
  Usuario                     Usuario?                      @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "id_usuario")
  Registros                   Registros[]

  @@index([id_cliente], map: "id_cliente_idx")
  @@index([id_estado_pago], map: "id_estado_pago_idx")
  @@index([id_estado_pedido], map: "id_estado_pedido_idx")
  @@index([id_etiqueta], map: "id_etiqueta_idx")
  @@index([id_usuario], map: "id_usuario_idx")
}

model Producto_Subproceso {
  id_tipo_producto     Int
  id_estado_subproceso Int
  orden_flujo          Int?
  Tipo_Producto        Tipo_Producto      @relation(fields: [id_tipo_producto], references: [id_tipo_producto], onDelete: NoAction, onUpdate: NoAction, map: "fk_Producto_Subproceso_tipo_producto")
  Estado_Subprocesos   Estado_Subprocesos @relation(fields: [id_estado_subproceso], references: [id_estado_subproceso], onDelete: NoAction, onUpdate: NoAction, map: "fk_Producto_Subproceso_estado_subproceso")

  @@id([id_tipo_producto, id_estado_subproceso])
  @@index([id_estado_subproceso], map: "id_estado_subproceso_idx")
}

model Registro_Etapas {
  id_registro        Int            @id
  fecha_hora_entrada DateTime?      @db.DateTime(0)
  fecha_hora_salida  DateTime?      @db.DateTime(0)
  id_estado_pedido   Int?
  Estado_Pedido      Estado_Pedido? @relation(fields: [id_estado_pedido], references: [id_estado_pedido], onDelete: NoAction, onUpdate: NoAction, map: "Registro_Etapas_Estado_Pedido_FK")
  Registros          Registros      @relation(fields: [id_registro], references: [ID_REGISTRO], onDelete: NoAction, onUpdate: NoAction, map: "Registro_Etapas_Registros_FK")

  @@index([id_estado_pedido], map: "id_estado_pedido_idx")
}

model Registro_Pago {
  id_registro                                                    Int          @id 
  fecha_registro                                                 DateTime?    @db.DateTime(0)
  observacion                                                    String?      @db.LongText
  id_estado_pago_anterior                                        Int?
  id_estado_pago_nuevo                                           Int?
  Estado_Pago_Registro_Pago_id_estado_pago_nuevoToEstado_Pago    Estado_Pago? @relation("Registro_Pago_id_estado_pago_nuevoToEstado_Pago", fields: [id_estado_pago_nuevo], references: [id_estado_pago], onDelete: NoAction, onUpdate: NoAction, map: "Registro_Pago_Estado_Pago_FK")
  Estado_Pago_Registro_Pago_id_estado_pago_anteriorToEstado_Pago Estado_Pago? @relation("Registro_Pago_id_estado_pago_anteriorToEstado_Pago", fields: [id_estado_pago_anterior], references: [id_estado_pago], onDelete: NoAction, onUpdate: NoAction, map: "Registro_Pago_Estado_Pago_FK_1")
  Registros                                                      Registros    @relation(fields: [id_registro], references: [ID_REGISTRO], onDelete: NoAction, onUpdate: NoAction, map: "Registro_Pago_Registros_FK")

  @@index([id_estado_pago_anterior], map: "id_estado_pago_idx")
  @@index([id_estado_pago_nuevo], map: "Registro_Pago_Estado_Pago_FK")
}

model Tipo_Producto {
  id_tipo_producto     Int                   @id @default(autoincrement())
  nombre_producto      String?               @db.VarChar(255)
    descripcion_producto String?               @db.Text
    capacidad_diaria     Int?                  @default(0)
  Detalle_pedido       Detalle_pedido[]
  Producto_Subproceso  Producto_Subproceso[]
}

model Usuario {
  id_usuario             Int                     @id @default(autoincrement())
  id_auth0               String                  @unique @db.VarChar(128)
  correo_usuario         String                  @unique @db.VarChar(255)
  rut_usuario            String?                 @db.VarChar(12)
  nombre_usuario         String?                 @db.VarChar(100)
  apellido_usuario       String?                 @db.VarChar(100)
  rol_usuario            String?                 @db.VarChar(50)
  estado_usuario         String?                 @db.VarChar(30)
  pin_hash               String?                 @db.VarChar(255)
  pin_salt               String?                 @db.VarChar(64)
  pin_fingerprint        String?                 @unique @db.Char(64)
  pin_pending_ciphertext String?                 @db.Text
  pin_pending_iv         String?                 @db.VarChar(64)
  pin_pending_tag        String?                 @db.VarChar(64)
  pin_accepted_at        DateTime?
  pin_failed_attempts    Int                     @default(0)
  pin_locked_until       DateTime?
  Avance_Lanyard         Avance_Lanyard[]
  Comentario_Produccion  Comentario_Produccion[]
  MENSAJE_USUARIO        MENSAJE_USUARIO[]
  Pedido_Etiqueta        Pedido_Etiqueta[]
  Pedidos                Pedidos[]
  PinRecoveryChallenge   PinRecoveryChallenge[]
  Registros              Registros[]
}

model etiqueta {
  id_etiqueta     Int               @id
  nombre_etiqueta String?           @db.VarChar(100)
  descripcion     String?           @db.Text
  esta_activa     Int?              @db.TinyInt
  Pedido_Etiqueta Pedido_Etiqueta[]
  Pedidos         Pedidos[]
}

model registro_subprocesos {
  id_registro          Int                 @id
  fecha_hora_entrada   DateTime?           @db.DateTime(0)
  fecha_hora_salida    DateTime?           @db.DateTime(0)
  id_detalle_pedido    Int?
  id_estado_subproceso Int?
  Avance_Lanyard       Avance_Lanyard[]
  Estado_Subprocesos   Estado_Subprocesos? @relation(fields: [id_estado_subproceso], references: [id_estado_subproceso], onDelete: NoAction, onUpdate: NoAction, map: "fk_registro_subprocesos_estado_subprocesos")
  Detalle_pedido       Detalle_pedido?     @relation(fields: [id_detalle_pedido], references: [id_detalle_pedido], onDelete: NoAction, onUpdate: NoAction, map: "fk_registro_subprocesos_detalle_pedido")
  Registros            Registros           @relation(fields: [id_registro], references: [ID_REGISTRO], onDelete: NoAction, onUpdate: NoAction, map: "registro_subprocesos_Registros_FK")

  @@index([id_detalle_pedido], map: "id_detalle_pedido_idx")
  @@index([id_estado_subproceso], map: "id_estado_subproceso_idx")
}

model Avance_Lanyard {
  id_avance_lanyard      Int                  @id @default(autoincrement())
  id_detalle_pedido      Int
  fecha_produccion       DateTime             @db.Date
  cantidad_dia           Int                  @default(0)
  cantidad_acumulada     Int                  @default(0)
  porcentaje_acumulado   Decimal              @default(0) @db.Decimal(5, 2)
  capacidad_diaria_referencia Int             @default(1200)
  id_usuario_registra    Int
  id_registro_subproceso Int?
  observacion            String?              @db.Text
  fecha_registro         DateTime             @default(now()) @db.DateTime(0)
  fecha_actualizacion    DateTime?            @db.DateTime(0)
  Detalle_pedido         Detalle_pedido       @relation(fields: [id_detalle_pedido], references: [id_detalle_pedido], onDelete: NoAction, onUpdate: NoAction, map: "fk_avance_lanyard_detalle")
  Usuario                Usuario              @relation(fields: [id_usuario_registra], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_avance_lanyard_usuario")
  registro_subprocesos   registro_subprocesos? @relation(fields: [id_registro_subproceso], references: [id_registro], onDelete: SetNull, onUpdate: NoAction, map: "fk_avance_lanyard_registro_subproceso")

  @@unique([id_detalle_pedido, fecha_produccion], map: "uq_avance_lanyard_detalle_fecha")
  @@index([fecha_produccion], map: "idx_avance_lanyard_fecha")
  @@index([id_usuario_registra], map: "idx_avance_lanyard_usuario")
  @@index([id_registro_subproceso], map: "idx_avance_lanyard_registro_subproceso")
}

model MENSAJE_USUARIO {
  leido_     Boolean @default(false) @map("leido?")
  oculto_    Boolean @default(false) @map("oculto?")
  id_usuario Int
  id_mensaje Int
  Mensaje    Mensaje @relation(fields: [id_mensaje], references: [id_mensaje], onDelete: NoAction, onUpdate: NoAction, map: "MENSAJE_USUARIO_Mensaje_FK")
  Usuario    Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "MENSAJE_USUARIO_Usuario_FK")

  @@id([id_usuario, id_mensaje])
  @@index([id_mensaje], map: "MENSAJE_USUARIO_Mensaje_FK")
}

model Mensaje {
  id_mensaje        Int               @id @default(autoincrement())
  contenido         String            @db.Text
  fecha_publicacion DateTime?         @db.Timestamp(0)
  Asunto            String            @db.Text
  id_pedido         Int?
  MENSAJE_USUARIO   MENSAJE_USUARIO[]
  Pedidos           Pedidos?          @relation(fields: [id_pedido], references: [id_pedido], onDelete: NoAction, onUpdate: NoAction, map: "Mensaje_Pedidos_FK")

  @@index([id_pedido], map: "Mensaje_Pedidos_FK")
}

model Pedido_Etiqueta {
  id_pedido         Int
  id_etiqueta       Int
  fecha_asignacion  DateTime @default(now()) @db.DateTime(0)
  id_usuario_asigna Int?
  etiqueta          etiqueta @relation(fields: [id_etiqueta], references: [id_etiqueta], map: "Pedido_Etiqueta_Etiqueta_FK")
  Pedidos           Pedidos  @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade, map: "Pedido_Etiqueta_Pedidos_FK")
  Usuario           Usuario? @relation(fields: [id_usuario_asigna], references: [id_usuario], map: "Pedido_Etiqueta_Usuario_FK")

  @@id([id_pedido, id_etiqueta])
  @@index([id_etiqueta], map: "Pedido_Etiqueta_Etiqueta_FK")
  @@index([id_usuario_asigna], map: "Pedido_Etiqueta_Usuario_FK")
}

model PinRecoveryChallenge {
  id_pin_recovery_challenge Int       @id @default(autoincrement())
  id_usuario                Int
  code_hash                 String    @db.VarChar(255)
  code_salt                 String    @db.VarChar(64)
  expires_at                DateTime
  failed_attempts           Int       @default(0)
  used_at                   DateTime?
  delivery_status           String    @db.VarChar(30)
  created_at                DateTime  @default(now())
  Usuario                   Usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_pin_recovery_usuario")

  @@index([id_usuario, created_at], map: "idx_pin_recovery_user_created")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Registros {
  ID_REGISTRO          Int                   @id @default(autoincrement())
  FECHA_HORA           DateTime              @db.Timestamp(0)
  id_pedido            Int?
  id_usuario           Int?
  observacion          String?               @db.Text
  Registro_Etapas      Registro_Etapas?
  Registro_Pago        Registro_Pago?
  Pedidos              Pedidos?              @relation(fields: [id_pedido], references: [id_pedido], onDelete: NoAction, onUpdate: NoAction, map: "Registros_Pedidos_FK")
  Usuario              Usuario?              @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "Registros_Usuario_FK")
  registro_subprocesos registro_subprocesos?

  @@index([id_pedido], map: "Registros_Pedidos_FK")
  @@index([id_usuario], map: "Registros_Usuario_FK")
}

model Pedido_Item_Sin_Seguimiento {
  id_item_sin_seguimiento Int       @id @default(autoincrement())
  id_pedido               Int
  codigo                  String?   @db.VarChar(50)
  producto                String    @db.VarChar(255)
  cantidad                Int?
  subfamilia              String?   @db.VarChar(100)
  fecha_registro          DateTime? @default(now()) @db.Timestamp(0)
  Pedidos                 Pedidos   @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade, onUpdate: NoAction, map: "Pedido_Item_Sin_Seguimiento_Pedidos_FK")

  @@index([id_pedido])
}

enum Dise_o_Tarjeta_tipo_tarjeta {
  banda
  chip

  @@map("Diseño_Tarjeta_tipo_tarjeta")
}
